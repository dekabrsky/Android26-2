<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:angle="45"
                android:startColor="#12001F"
                android:centerColor="#2B1055"
                android:endColor="#050816" />
        </shape>
    </item>

    <item
        android:gravity="center"
        android:width="190dp"
        android:height="190dp">
        <shape android:shape="oval">
            <solid android:color="#C1440E" />
        </shape>
    </item>

    <item
        android:gravity="center"
        android:width="145dp"
        android:height="145dp">
        <shape android:shape="oval">
            <solid android:color="#E27D45" />
        </shape>
    </item>

    <item
        android:gravity="center"
        android:width="95dp"
        android:height="95dp">
        <shape android:shape="oval">
            <solid android:color="#9E2A12" />
        </shape>
    </item>

</layer-list>