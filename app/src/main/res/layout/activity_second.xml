<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SecondActivity">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:navigationIcon="@drawable/arrow_back"
        android:title="@string/article_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/article2_title"
                android:textSize="22sp"
                android:textColor="@color/black"
                android:layout_margin="10dp"
                />

            <TextView
                android:id="@+id/textViewBlock1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/article2_block1"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_margin="10dp"
                />

            <ImageView
                android:id="@+id/article2Image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="Двухэтажная «сталинка» серии 1-201"
                android:layout_margin="10dp"
                />

            <TextView
                android:id="@+id/textViewBlock2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/article2_block2"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_margin="10dp"
                />
        </LinearLayout>



    </ScrollView>

</LinearLayout>