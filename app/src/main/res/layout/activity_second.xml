<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SecondActivity">

    <!-- Тулбар с кнопкой назад -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:navigationContentDescription="Назад"
        android:navigationIcon="@drawable/arrow_back"
        android:title="@string/article2_title" />

    <!-- Прокручиваемое содержимое статьи -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Автор и дата — мелкий текст, правое выравнивание -->
            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_author"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/colorAuthor"
                android:gravity="end"
                android:layout_marginBottom="12dp" />

            <!-- Изображение статьи -->
            <ImageView
                android:id="@+id/ivArticleImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:contentDescription="@string/article2_title"
                android:layout_marginBottom="16dp" />

            <!-- Вводный абзац — крупный, жирный -->
            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_intro"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="12dp" />

            <!-- Основной текст 1 -->
            <TextView
                android:id="@+id/tvBody1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_body1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="16dp" />

            <!-- Цитата — курсив, центр, с фоновым цветом -->
            <TextView
                android:id="@+id/tvQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_quote"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textStyle="italic"
                android:gravity="center"
                android:background="@color/colorQuoteBg"
                android:padding="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Основной текст 2 — выравнивание по ширине -->
            <TextView
                android:id="@+id/tvBody2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_body2"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:gravity="fill_horizontal"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="12dp" />

            <!-- Основной текст 3 -->
            <TextView
                android:id="@+id/tvBody3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_body3"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="24dp" />

            <!-- Переключатель "Прочитано" -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switch_read"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginBottom="16dp" />

            <!-- Счётчик лайков / дизлайков — как на первом экране -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <!-- Лайк -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="32dp">

                    <ImageButton
                        android:id="@+id/btnLike"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_thumb_up"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/label_likes"
                        android:padding="10dp" />

                    <TextView
                        android:id="@+id/tvLikeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                </LinearLayout>

                <!-- Дизлайк -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnDislike"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_thumb_down"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/label_dislikes"
                        android:padding="10dp" />

                    <TextView
                        android:id="@+id/tvDislikeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                </LinearLayout>

            </LinearLayout>

            <!-- Кнопка "Поделиться" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_share"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
