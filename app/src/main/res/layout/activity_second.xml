<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/space_black"
    tools:context=".SecondActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/space_black"
            app:titleTextColor="@color/accent_cyan"
            app:title="@string/article_title"
            app:navigationIcon="@drawable/arrow_back"
            app:navigationIconTint="@color/accent_cyan" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:background="@drawable/space_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#161B22"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/articleTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/article_2_title"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_cyan"
                        android:lineSpacingExtra="6sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/articleImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Space"
                            android:background="#21262D"
                            tools:srcCompat="@tools:sample/backgrounds/scenic" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/article_2_text_1"
                        android:textSize="18sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingMultiplier="1.4" />

                    <!-- Цитата -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp"
                        android:background="#1A00B4D8"
                        android:padding="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/accent_cyan" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/article_2_quote"
                            android:textSize="18sp"
                            android:textStyle="italic"
                            android:textColor="@color/accent_cyan"
                            android:layout_marginStart="16dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/article_2_text_2"
                        android:textSize="18sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginBottom="24dp"
                        android:lineSpacingMultiplier="1.4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/article_2_subtitle_hydro"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_cyan"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/article_2_text_3"
                        android:textSize="18sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginBottom="32dp"
                        android:lineSpacingMultiplier="1.4" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#21262D"
                        android:layout_marginBottom="24dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchRead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_read_title"
                        android:textColor="@color/star_white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        app:thumbTint="@color/accent_cyan"
                        app:trackTint="@color/nebula_purple" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
