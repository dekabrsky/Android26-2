<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Заголовок статьи: крупный, жирный -->
    <style name="ArticleTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/article_text</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- Автор / время чтения: мелкий, прижат к правому краю -->
    <style name="ArticleByline">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/article_muted</item>
        <item name="android:gravity">end</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Подзаголовок: курсив -->
    <style name="ArticleLead">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/article_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Подпись к картинке: по центру -->
    <style name="ArticleCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/article_muted</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <!-- Заголовок раздела -->
    <style name="ArticleHeading">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/article_accent</item>
    </style>

    <!-- Основной текст -->
    <style name="ArticleBody">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/article_text</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Цитата: курсив с засечками -->
    <style name="ArticleQuote">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/article_text</item>
    </style>
</resources>
